		hdf5_dump_interval = 1         //In finest level cycle units
		hdf5_dump_dirname = "outputDir_mesh"
		variables = "phi", "Phid_z", "dphi2", "Phid_x", "Phid_y", "Psisf", "phi2", "Psi", "phi22", "vxplus", "vxminus", "vyplus", "vyminus", "vzplus", "vzminus", "vorticity_norm", "d2tphi", "Chi_t", "Chi_x", "Chi_y", "Chi_z", "Chi_norm"      // variables to dump
	}
