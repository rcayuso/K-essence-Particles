		variables = "phi", "Phid_z", "dphi2", "Phid_x", "Phid_y", "Psisf", "phi2", "Psi", "phi22", "vxplus", "vxminus", "vyplus", "vyminus", "vzplus", "vzminus", "vorticity_norm", "d2tphi", "Chi_t", "Chi_x", "Chi_y", "Chi_z", "Chi_norm"
		coordinates = 0, 0, 0            //In domain units
